<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mass Effect Archipelago Launcher</AssemblyName>
    <RootNamespace>APSetup</RootNamespace>
    <Version>0.5.1</Version>
    <Product>Mass Effect Archipelago Launcher</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>launcher.ico</ApplicationIcon>
    <!-- Program.Main starts the window (or the command line); there is no App.xaml -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>APSetup.Program</StartupObject>
  </PropertyGroup>
  <PropertyGroup>
    <!-- LegendaryExplorerCore.csproj (TOC writing): vendor\LegendaryExplorer in this repo (see README), or override with -p:LexCoreProject=... -->
    <LexCoreProject Condition="'$(LexCoreProject)' == '' And Exists('..\..\vendor\LegendaryExplorer')">..\..\vendor\LegendaryExplorer\LegendaryExplorer\LegendaryExplorerCore\LegendaryExplorerCore.csproj</LexCoreProject>
    <LexCoreProject Condition="'$(LexCoreProject)' == ''">..\..\..\vendor\LegendaryExplorer\LegendaryExplorer\LegendaryExplorerCore\LegendaryExplorerCore.csproj</LexCoreProject>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The GitHub repository this launcher is built from (owner/name): tools/publish.py passes it from git -->
    <LauncherRepository Condition="'$(LauncherRepository)' == ''">Mass-Effect-LE-Archipelago/ME-Archipelago-Launcher</LauncherRepository>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LauncherRepository" Value="$(LauncherRepository)" />
  </ItemGroup>
  <ItemGroup>
    <!-- WPF leaves System.IO out of the implicit usings -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(LexCoreProject)" />
  </ItemGroup>
  <ItemGroup>
    <!-- option schemas exported from the worlds; a downloaded payload's options.json wins over these -->
    <EmbeddedResource Include="options-me1.json" LogicalName="options-me1.json" />
    <EmbeddedResource Include="options-me2.json" LogicalName="options-me2.json" />
    <EmbeddedResource Include="options-me3.json" LogicalName="options-me3.json" />
  </ItemGroup>
</Project>
